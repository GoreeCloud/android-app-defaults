diff --git a/android/app/src/main/kotlin/com/goreecloud/keyboard/KeyboardAccessibilityDelegate.kt b/android/app/src/main/kotlin/com/goreecloud/keyboard/KeyboardAccessibilityDelegate.kt
--- a/android/app/src/main/kotlin/com/goreecloud/keyboard/KeyboardAccessibilityDelegate.kt
